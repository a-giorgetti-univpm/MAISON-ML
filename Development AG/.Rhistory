newdata <- rbind(newdata, df_tmp)
}
#newdata$ecosystem <- as.factor(newdata$habitat)
newdata$predicted <- predict(model, newdata= newdata, type = "response", allow.new.levels = TRUE)
ggplot() + labs(x='heartrate-max', y='sis') +
geom_point(data=data, aes(x=`heartrate-max`, y=sis, color=participant), size = 2) + # surv_perc_norm
