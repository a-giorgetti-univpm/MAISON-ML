bt <- function(name) paste0("`", name, "`")
it_univariate_lmm <- function(outcome, predictors, data, out_prefix = "lmm") {
rows <- list()
for (pred in predictors) {
fml <- as.formula(paste(bt(outcome), "~", bt(pred), "+ (1|participant)"))
message("Fitting: ", deparse(fml))
fit <- tryCatch(
lmer(fml, data = data, REML = FALSE),  # ML for AIC comparison
error = function(e) e
)
if (inherits(fit, "error")) {
rows[[length(rows) + 1]] <- data.frame(
predictors = pred,
aic = NA_real_,
p_value = NA_real_,
estimate = NA_real_,
note = conditionMessage(fit),
stringsAsFactors = FALSE
)
next
}
sm <- summary(fit)$coefficients
# row name may be backtick-quoted or raw
rn <- rownames(sm)
pred_row <- which(rn == pred | rn == bt(pred) | gsub("`", "", rn) == pred)
pcol <- intersect(c("Pr(>|t|)", "Pr(>|z|)"), colnames(sm))
p_value <- if (length(pcol)) sm[pred_row[1], pcol[1]] else NA_real_
estimate <- sm[pred_row[1], "Estimate"]
rows[[length(rows) + 1]] <- data.frame(
predictors = pred,
aic = AIC(fit),
p_value = as.numeric(p_value),
estimate = as.numeric(estimate),
note = NA_character_,
stringsAsFactors = FALSE
)
}
out <- do.call(rbind, rows)
out <- out[order(out$aic, na.last = TRUE), , drop = FALSE]
rownames(out) <- NULL
out_path <- file.path(
"./new_results/mixed_models",
paste0(out_prefix, "_", outcome, "_R_AIC.csv")
)
write.csv2(out, out_path, row.names = FALSE)
message("Saved: ", out_path)
out
}
results_cont <- lapply(
col_resp_continuous,
fit_univariate_lmm,
predictors = x_col,
data = data,
out_prefix = "lmm"
)
results_cont <- lapply(
col_resp_continuous,
it_univariate_lmm,
predictors = x_col,
data = data,
out_prefix = "lmm"
)
names(results_cont) <- col_resp_continuous
message("Done. Best AIC models (continuous):")
for (nm in names(results_cont)) {
cat("\n===", nm, "===\n")
print(head(results_cont[[nm]], 5))
}
results_cat <- lapply(
intersect(col_resp_category, names(data)),
fit_univariate_lmm,
predictors = x_col,
data = data,
out_prefix = "lmm"
)
